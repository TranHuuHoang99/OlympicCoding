// use "Ctrl + Shift + B" to run this task (Cmd + Shift + B on macOS)
//
// This file is identical on Windows and macOS — no editing needed when you switch OS.
//   * Compile C++           : "cppbuild". The extension resolves the compiler automatically
//                             (MSYS2 ucrt64 g++ on Windows, /opt/homebrew/bin/g++-15 on macOS).
//   * Python path           : "${command:python.interpreterPath}" = whichever python VS Code is using.
//
// One-time setup on macOS (only once, never again):
//   brew install gcc python     -> provides g++-15 and /opt/homebrew/bin/python3, which the
//                                  C/C++ extension picks up automatically.
//   Make sure the Microsoft "Python" extension is installed on BOTH machines.
{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Compile C++",
            "command": "${command:cpptools.activeConfigCompilerPath}",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-DLOCAL",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Compiles the active file with the compiler of the active C/C++ configuration."
        },
        {
            "label": "Run C++ with Input",
            "type": "shell",
            "command": "./${fileBasenameNoExtension}",
            "args": [
                "<",
                "${workspaceFolder}/input.in"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "${default}"
                }
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "C/C++: Build and Run with Input",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Compile C++",
                "Run C++ with Input"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Python with Input File",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-u",
                "-I",
                "${file}",
                "<",
                "${workspaceFolder}/input.in"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "${default}"
                }
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}
